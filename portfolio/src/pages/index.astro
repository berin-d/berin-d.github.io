---
import Layout from "../layouts/Layout.astro";

// Components
import SelectionCard from "../components/react/SelectionCard.tsx";
import Profil from "../components/react/Profil.tsx";
---

<Layout>
	<!-- <Cursor client:load /> -->
	<div
		class="min-h-screen flex flex-col items-center"
		style="background: radial-gradient(circle at center top, #F5C1C5 0%, #D4EBF3 30%, #F3F8FC 70%, white 100%);"
	>
		<!-- Header -->
		<header>
			<Profil client:load></Profil>
		</header>

		<main class="w-full mx-auto px-6 pb-16 flex-1">
			<SelectionCard client:load></SelectionCard>
		</main>

		<footer
			class="w-full text-center text-sm text-gray-400 py-8 border-t border-gray-100"
		>
			<p>© 2026 My Portfolio. All rights reserved.</p>
		</footer>
	</div>
</Layout>

<style>
	.nav-item.active {
		color: #111827;
		border-bottom-color: #111827;
	}

</style>

